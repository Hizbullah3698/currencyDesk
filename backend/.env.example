DATABASE_URL=postgresql://currencydesk:currencydesk@localhost:5432/currencydesk
SESSION_SECRET=change-me-dev-secret
PORT=3001
NODE_ENV=development
COOKIE_NAME=cd.sid
SESSION_MAX_AGE_DAYS=30

# Comma-separated allowlist of origins the browser may call this API from, with credentials.
# LEAVE UNSET IN LOCAL DEV — the Vite dev proxy makes the browser see everything as same-origin,
# so no CORS header is needed and setting one here only adds a way to get it subtly wrong.
# Required in production, where the frontend and backend are separate Vercel projects on
# different origins. Never a wildcard: a credentialed (cookie-carrying) request cannot use one,
# and this allowlist is currently the only thing standing between a hostile page and a
# cross-site authenticated request (the session cookie is SameSite=None in production).
# FRONTEND_ORIGIN=https://currency-desk.vercel.app,https://currency-desk-preview.vercel.app
