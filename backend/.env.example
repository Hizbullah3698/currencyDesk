DATABASE_URL=postgresql://currencydesk:currencydesk@localhost:5432/currencydesk
SESSION_SECRET=change-me-dev-secret
PORT=3001
NODE_ENV=development
COOKIE_NAME=cd.sid
SESSION_MAX_AGE_DAYS=30

# The IANA timezone the desk keeps its books in. Every date the server derives on its own — a
# trade posted without a date, a manual journal entry, the day a cheque cleared, and the "not in
# the future" check — is computed in this zone, regardless of where the server or database runs.
# Optional; defaults to Asia/Karachi. Only change it if the desk moves.
# DESK_TIMEZONE=Asia/Karachi

# Comma-separated allowlist of origins the browser may call this API from, with credentials.
# LEAVE UNSET IN LOCAL DEV — the Vite dev proxy makes the browser see everything as same-origin,
# so no CORS header is needed and setting one here only adds a way to get it subtly wrong.
# Required in production, where the frontend and backend are separate Vercel projects on
# different origins. Never a wildcard: a credentialed (cookie-carrying) request cannot use one,
# and this allowlist is currently the only thing standing between a hostile page and a
# cross-site authenticated request (the session cookie is SameSite=None in production).
# FRONTEND_ORIGIN=https://currency-desk.vercel.app,https://currency-desk-preview.vercel.app

# Stage 3 of the CSRF rollout — see backend/src/middleware/csrf.ts.
#   unset/false : a mutating request with no X-CSRF-Token is ALLOWED and logged (stages 1-2)
#   "true"      : a mutating request with no X-CSRF-Token is REJECTED with 403 (stage 3)
# Do NOT set this to true until the frontend has been deployed sending the header AND the
# "[csrf] mutating request with no token" warnings have gone quiet in the backend logs — users
# on a cached pre-rollout bundle would otherwise be locked out of every trade and payment.
# Only the exact string "true" enables it, so a typo fails safe (open).
# CSRF_ENFORCE=true
