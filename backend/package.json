{
  "name": "currency-desk-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--conditions=development tsx watch src/index.ts",
    "build": "npm run build --workspace=@currencydesk/engine && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "cross-env NODE_OPTIONS=--conditions=development tsx src/db/migrate.ts",
    "seed:demo": "cross-env NODE_OPTIONS=--conditions=development tsx src/scripts/seedDemo.ts",
    "create-user": "cross-env NODE_OPTIONS=--conditions=development tsx src/scripts/createUser.ts",
    "set-username": "cross-env NODE_OPTIONS=--conditions=development tsx src/scripts/setUsername.ts",
    "set-password": "cross-env NODE_OPTIONS=--conditions=development tsx src/scripts/setPassword.ts",
    "csrf:gate": "cross-env NODE_OPTIONS=--conditions=development tsx src/scripts/csrfGate.ts",
    "csrf:gate:prod": "cross-env DOTENV_CONFIG_PATH=.env.production NODE_OPTIONS=--conditions=development tsx src/scripts/csrfGate.ts",
    "pretest": "cross-env DATABASE_URL=postgresql://currencydesk:currencydesk@localhost:5432/currencydesk_test NODE_OPTIONS=--conditions=development tsx src/scripts/setupTestDb.ts && cross-env DATABASE_URL=postgresql://currencydesk:currencydesk@localhost:5432/currencydesk_test NODE_OPTIONS=--conditions=development tsx src/db/migrate.ts",
    "test": "cross-env DATABASE_URL=postgresql://currencydesk:currencydesk@localhost:5432/currencydesk_test vitest run",
    "snapshot:dump": "cross-env NODE_OPTIONS=--conditions=development tsx src/scripts/dumpSnapshot.ts",
    "snapshot:dump:prod": "cross-env DOTENV_CONFIG_PATH=.env.production NODE_OPTIONS=--conditions=development tsx src/scripts/dumpSnapshot.ts",
    "backfill:vouchers": "cross-env NODE_OPTIONS=--conditions=development tsx src/scripts/backfillVouchers.ts",
    "backfill:vouchers:prod": "cross-env DOTENV_CONFIG_PATH=.env.production NODE_OPTIONS=--conditions=development tsx src/scripts/backfillVouchers.ts",
    "reset:business": "cross-env NODE_OPTIONS=--conditions=development tsx src/scripts/resetBusinessData.ts",
    "reset:business:prod": "cross-env DOTENV_CONFIG_PATH=.env.production NODE_OPTIONS=--conditions=development tsx src/scripts/resetBusinessData.ts"
  },
  "dependencies": {
    "@currencydesk/engine": "*",
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
